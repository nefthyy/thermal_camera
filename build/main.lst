 113:Core/Src/main.c ****   HAL_Delay(80);
 114:Core/Src/main.c ****   if (HAL_I2C_IsDeviceReady(&hi2c3, MLX90640_ADDR << 1, 3, 100) != HAL_OK)
 115:Core/Src/main.c ****     printf("\r\nMLX90640 not found at 0x%02X (I2C err 0x%lX)\r\n", MLX90640_ADDR, HAL_I2C_GetError(
 116:Core/Src/main.c ****   else
 117:Core/Src/main.c ****     printf("\r\nMLX90640 found at 0x%02X\r\n", MLX90640_ADDR);
 118:Core/Src/main.c ****   status = MLX90640_SetRefreshRate(MLX90640_ADDR, RefreshRate);
 119:Core/Src/main.c ****   if (status != 0) printf("SetRefreshRate error: %d\r\n", status);
 120:Core/Src/main.c ****   status = MLX90640_SetChessMode(MLX90640_ADDR);
 121:Core/Src/main.c ****   if (status != 0) printf("SetChessMode error: %d\r\n", status);
 122:Core/Src/main.c ****   uint16_t ctrl;
 123:Core/Src/main.c ****   if (MLX9064x_I2CRead(MLX90640_ADDR, 0x800D, 1, &ctrl) == 0)
 124:Core/Src/main.c ****   {
 125:Core/Src/main.c ****     printf("Control register: 0x%04X\r\n", ctrl);
 126:Core/Src/main.c ****     // subpage mode on (bit 0), subpage repeat off (bit 3) so subpages 0 and 1 alternate
 127:Core/Src/main.c ****     uint16_t want = (ctrl | 0x0001) & ~0x0008;
 128:Core/Src/main.c ****     if (want != ctrl) MLX9064x_I2CWrite(MLX90640_ADDR, 0x800D, want);
 129:Core/Src/main.c ****   }
 130:Core/Src/main.c ****   static paramsMLX90640 mlx90640;
 131:Core/Src/main.c ****   status = MLX90640_DumpEE(MLX90640_ADDR, eeMLX90640);
 132:Core/Src/main.c ****   if (status != 0) printf("\r\nload system parameters error with code:%d\r\n",status);
 133:Core/Src/main.c ****   status = MLX90640_ExtractParameters(eeMLX90640, &mlx90640);
 134:Core/Src/main.c ****   if (status != 0) printf("\r\nParameter extraction failed with error code:%d\r\n",status);
 135:Core/Src/main.c ****   /* USER CODE END 2 */
 136:Core/Src/main.c **** 
 137:Core/Src/main.c ****   /* Infinite loop */
 138:Core/Src/main.c ****   /* USER CODE BEGIN WHILE */
 139:Core/Src/main.c ****   while (1)
 140:Core/Src/main.c ****   {
 141:Core/Src/main.c ****     /* USER CODE END WHILE */
 142:Core/Src/main.c **** 
 143:Core/Src/main.c ****     /* USER CODE BEGIN 3 */
 144:Core/Src/main.c ****     // read subpages until both halves of the chessboard are filled in
 145:Core/Src/main.c ****     int ok = 1, got = 0, tries = 0;
ARM GAS  /tmp/cchWtjRi.s 			page 4


 146:Core/Src/main.c ****     float Ta = 0;
 147:Core/Src/main.c ****     while (got != 0x3 && tries++ < 4)
 148:Core/Src/main.c ****     {
 149:Core/Src/main.c ****         int sp = MLX90640_GetFrameData(MLX90640_ADDR, frame);
 150:Core/Src/main.c ****         if (sp < 0) { printf("GetFrameData error: %d\r\n", sp); ok = 0; break; }
 151:Core/Src/main.c ****         Ta = MLX90640_GetTa(frame, &mlx90640);
 152:Core/Src/main.c ****         MLX90640_CalculateTo(frame, &mlx90640, emissivity, Ta - TA_SHIFT, mlx90640To);
 153:Core/Src/main.c ****         got |= 1 << sp;
 154:Core/Src/main.c ****     }
 155:Core/Src/main.c ****     if (ok && got != 0x3)
 156:Core/Src/main.c ****     {
 157:Core/Src/main.c ****         printf("Only got subpage mask %d (ctrl 0x%04X)\r\n", got, frame[832]);
 158:Core/Src/main.c ****         ok = 0;
 159:Core/Src/main.c ****     }
 160:Core/Src/main.c **** 
 161:Core/Src/main.c ****     // sanity check about once a second: Ta should be near room temp, Vdd near 3300 mV
 162:Core/Src/main.c ****     static int nFrames = 0;
 163:Core/Src/main.c ****     if (ok && ++nFrames % 4 == 0)
 164:Core/Src/main.c ****         printf("Ta=%d C  Vdd=%d mV\r\n", (int)Ta, (int)(MLX90640_GetVdd(frame, &mlx90640) * 1000));
 165:Core/Src/main.c **** 
 166:Core/Src/main.c ****     // only send complete frames (both subpages read successfully)
 167:Core/Src/main.c ****     if (ok)
 168:Core/Src/main.c ****     {
 169:Core/Src/main.c ****         HAL_UART_Transmit(&huart2, (uint8_t *)"FRAME", 5, HAL_MAX_DELAY);
 170:Core/Src/main.c ****         HAL_UART_Transmit(&huart2, (uint8_t *)mlx90640To, sizeof(mlx90640To), HAL_MAX_DELAY);
 171:Core/Src/main.c ****     }
 172:Core/Src/main.c **** 
 173:Core/Src/main.c **** 
 174:Core/Src/main.c **** 
 175:Core/Src/main.c **** 		
 176:Core/Src/main.c ****   }
 177:Core/Src/main.c ****   /* USER CODE END 3 */
